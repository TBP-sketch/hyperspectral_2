/* =============================================================================
   高光谱数据处理平台 — 浅色主题（科研工具 / 现代 IDE 扁平风格）
   字体: Microsoft YaHei, SimHei, sans-serif | 基准 10pt
   ============================================================================= */

/* ----- 全局基础 ----- */
QWidget {
    font-family: "Microsoft YaHei", "SimHei", sans-serif;
    font-size: 10pt;
    font-weight: bold;
    color: #333333;
}

/* 背景图由 MainWindow::paintEvent 绘制；此处保持透明以便透出影像 */
QMainWindow {
    background: transparent;
}

QWidget#centralWorkspace {
    background: transparent;
}

QStackedWidget,
QStackedWidget#mainStack {
    background: transparent;
}

/* ----- 菜单栏 ----- */
QMenuBar {
    background-color: rgba(245, 246, 248, 0.82);
    border-bottom: 1px solid rgba(209, 213, 219, 0.9);
    color: #333333;
    padding: 2px 0;
}

QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #E0E0E0;
}

QMenu {
    background-color: rgba(255, 255, 255, 0.94);
    border: 1px solid #D1D5DB;
    padding: 4px 0;
}

QMenu::item {
    padding: 6px 28px 6px 16px;
}

QMenu::item:selected {
    background-color: #E8F8F5;
    color: #333333;
}

/* ----- 工具栏 ----- */
QToolBar#mainToolBar {
    background-color: rgba(245, 246, 248, 0.78);
    border-bottom: 1px solid rgba(209, 213, 219, 0.85);
    spacing: 6px;
    padding: 4px 6px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px 8px;
    color: #333333;
}

QToolButton:hover {
    background-color: rgba(226, 232, 240, 0.95);
}

QToolButton:pressed {
    background-color: rgba(203, 213, 225, 0.98);
}

/* 与左侧导航「选中项」一致：深底 + 白边框 */
QToolButton:checked {
    background-color: rgba(44, 62, 80, 0.88);
    border: 1px solid #FFFFFF;
    border-radius: 4px;
    color: #FFFFFF;
}

QToolButton:checked:hover {
    background-color: rgba(52, 73, 94, 0.92);
    border: 1px solid #FFFFFF;
}

/* ----- 左侧导航 QListWidget（半透明，透出背景图） ----- */
QListWidget#navList {
    background-color: rgba(255, 255, 255, 0.38);
    border: none;
    border-right: 1px solid rgba(209, 213, 219, 0.75);
    outline: none;
    padding: 8px 0;
}

QListWidget#navList::item {
    min-height: 50px;
    padding-left: 20px;
    padding-right: 12px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin: 2px 8px 2px 0;
    border: none;
    border-left: 4px solid transparent;
    border-radius: 0 6px 6px 0;
    color: #333333;
    font-size: 11pt;
    background-color: rgba(255, 255, 255, 0.22);
}

QListWidget#navList::item:hover {
    background-color: rgba(224, 224, 224, 0.72);
    color: #000000;
}

QListWidget#navList::item:selected {
    background-color: rgba(44, 62, 80, 0.92);
    color: #FFFFFF;
    border-left: 4px solid #FFFFFF;
}

QListWidget#navList::item:selected:hover {
    background-color: rgba(52, 73, 94, 0.94);
    color: #FFFFFF;
    border-left: 4px solid #FFFFFF;
}

QListWidget#navList::item:pressed {
    background-color: rgba(203, 213, 225, 0.92);
    color: #020617;
}

/* ----- 次要按钮：交互节奏与左侧导航项一致（半透明底 → 悬停变亮 → 按下反馈） ----- */
QPushButton {
    background-color: rgba(255, 255, 255, 0.55);
    color: #0F172A;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: normal;
    min-height: 1.2em;
}

QPushButton:hover {
    background-color: rgba(224, 224, 224, 0.72);
    border-color: rgba(255, 255, 255, 0.65);
    color: #000000;
}

QPushButton:pressed {
    background-color: rgba(203, 213, 225, 0.92);
    border-color: #CBD5E1;
    color: #020617;
    padding-top: 9px;
    padding-bottom: 7px;
}

QPushButton:disabled {
    background-color: rgba(245, 245, 245, 0.75);
    color: #AAAAAA;
    border-color: #DDDDDD;
}

/* ----- 主要按钮：绿色填充 + 白色描边（与侧栏选中条统一为白边） ----- */
QPushButton#primaryButton {
    background-color: #27AE60;
    color: #FFFFFF;
    border: 1px solid #FFFFFF;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton#primaryButton:hover {
    background-color: #2ECC71;
    border: 1px solid #FFFFFF;
}

QPushButton#primaryButton:pressed {
    background-color: #1E8449;
    border: 1px solid #FFFFFF;
    padding-top: 9px;
    padding-bottom: 7px;
}

QPushButton#primaryButton:disabled {
    background-color: #A9DFBF;
    color: #F4F6F6;
}

/* 显式次要：与全局 QPushButton 同一套交互 */
QPushButton#secondaryButton {
    background-color: rgba(255, 255, 255, 0.55);
    color: #0F172A;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: normal;
}

QPushButton#secondaryButton:hover {
    background-color: rgba(224, 224, 224, 0.72);
    border-color: rgba(255, 255, 255, 0.65);
    color: #000000;
}

QPushButton#secondaryButton:pressed {
    background-color: rgba(203, 213, 225, 0.92);
    border-color: #CBD5E1;
    color: #020617;
}

/* ----- 分组框（半透明底，不遮挡背景图） ----- */
QGroupBox {
    border: 1px solid rgba(224, 224, 224, 0.85);
    border-radius: 8px;
    margin-top: 1.2em;
    padding-top: 10px;
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.76);
    font-weight: normal;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 0;
    padding: 0 6px;
    color: #34495E;
    font-weight: bold;
    background-color: rgba(255, 255, 255, 0.82);
}

/* ----- 输入框与下拉框 ----- */
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(209, 213, 219, 0.95);
    border-radius: 4px;
    padding: 5px 8px;
    color: #333333;
    min-height: 1.1em;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 2px solid #64748B;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    border-left: 1px solid rgba(209, 213, 219, 0.9);
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: rgba(249, 250, 251, 0.92);
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.95);
    selection-background-color: #E8F8F5;
    selection-color: #333333;
    padding: 4px;
}

/* ----- 标签与复选 ----- */
QLabel {
    color: #333333;
}

QCheckBox,
QRadioButton {
    color: #333333;
    spacing: 8px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

/* ----- 滑块 ----- */
QSlider::groove:horizontal {
    border: 1px solid rgba(209, 213, 219, 0.85);
    height: 6px;
    background: rgba(229, 231, 235, 0.75);
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #475569;
    border: 1px solid #FFFFFF;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #64748B;
    border: 1px solid #FFFFFF;
}

/* ----- 进度条 ----- */
QProgressBar {
    border: 1px solid rgba(209, 213, 219, 0.9);
    border-radius: 4px;
    text-align: center;
    background-color: rgba(255, 255, 255, 0.72);
    color: #333333;
    min-height: 20px;
}

QProgressBar::chunk {
    background-color: #27AE60;
    border-radius: 3px;
}

/* ----- 文本区域 ----- */
QTextEdit,
QPlainTextEdit,
QTextBrowser {
    background-color: rgba(255, 255, 255, 0.84);
    border: 1px solid rgba(209, 213, 219, 0.92);
    border-radius: 4px;
    padding: 6px;
    color: #333333;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    border: 2px solid #64748B;
}

/* ----- 分割器 ----- */
QSplitter::handle {
    background-color: rgba(209, 213, 219, 0.65);
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ----- 状态栏 ----- */
QStatusBar {
    background-color: rgba(245, 246, 248, 0.8);
    border-top: 1px solid rgba(209, 213, 219, 0.85);
    color: #333333;
}

QStatusBar::item {
    border: none;
}

/* ----- 滚动条（清爽扁平） ----- */
QScrollBar:vertical {
    background: rgba(240, 242, 245, 0.45);
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(197, 203, 211, 0.85);
    min-height: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(168, 176, 188, 0.95);
}

QScrollBar:horizontal {
    background: rgba(240, 242, 245, 0.45);
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: rgba(197, 203, 211, 0.85);
    min-width: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}

/* ----- 对话框与 QMessageBox -----
   QMessageBox 必须在 QLabel 上显式设置 background，否则在 Windows 下易出现整块纯黑。 */
QDialog {
    background-color: rgba(241, 245, 249, 0.97);
    border: 1px solid rgba(203, 213, 225, 0.95);
    border-radius: 8px;
}

QDialog QLabel {
    color: #1E293B;
    background-color: transparent;
}

QDialog QGroupBox {
    background-color: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(203, 213, 225, 0.9);
}

QDialogButtonBox QPushButton {
    min-width: 72px;
}

/* 与四模块按钮同系的灰蓝（slate） */
QMessageBox {
    background-color: #5A6B80;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 8px;
}

QMessageBox QLabel {
    background-color: #5A6B80;
    color: #F8FAFC;
    border: none;
}

QMessageBox QLabel#qt_msgbox_label {
    background-color: #5A6B80;
    color: #F8FAFC;
}

QMessageBox QLabel#qt_msgbox_icon_label {
    background-color: transparent;
}

QMessageBox QTextEdit,
QMessageBox QPlainTextEdit {
    background-color: #5A6B80;
    color: #F8FAFC;
    border: 1px solid rgba(255, 255, 255, 0.35);
}

QMessageBox QDialogButtonBox {
    background-color: #5A6B80;
    border: none;
}

QMessageBox QPushButton {
    background-color: #6D7F95;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: 6px;
    padding: 6px 16px;
    min-width: 80px;
}

QMessageBox QPushButton:hover {
    background-color: #7D91A8;
    border: 1px solid rgba(255, 255, 255, 0.85);
}

QMessageBox QPushButton:pressed {
    background-color: #4A5568;
}

QInputDialog {
    background-color: rgba(241, 245, 249, 0.98);
    border: 1px solid rgba(203, 213, 225, 0.95);
    border-radius: 8px;
}

QInputDialog QLabel {
    color: #1E293B;
}

QColorDialog,
QFontDialog,
QFileDialog {
    background-color: rgba(241, 245, 249, 0.97);
}

QWidget#helpWindow {
    background-color: rgba(241, 245, 249, 0.97);
}

QWidget#helpWindow QTextBrowser {
    background-color: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(203, 213, 225, 0.92);
    border-radius: 6px;
    color: #1E293B;
    padding: 8px;
}

/* =============================================================================
   四模块主界面（objectName=modulePage）：正文与标签统一白色，配深色半透明衬底
   ============================================================================= */

QWidget#modulePage {
    color: #FFFFFF;
    font-weight: bold;
    /* 不使用 WA_TranslucentBackground + 全透明，否则 Windows 下 QComboBox 弹出层会错位/只显示选中行 */
    background-color: rgba(15, 23, 42, 0.88);
    border-radius: 6px;
}

/* 预处理 / 导出：日志区加粗白字 */
QTextEdit#moduleLogEdit {
    color: #FFFFFF;
    font-weight: bold;
    background-color: rgba(15, 23, 42, 0.82);
}

/* 大气校正进度条：棕色填充（需高于全局 QProgressBar::chunk） */
QWidget#modulePage QProgressBar#atmProgressBar::chunk {
    background-color: #8B5A2B;
    border-radius: 3px;
}

QWidget#modulePage QLabel {
    color: #FFFFFF;
    font-weight: bold;
}

QWidget#modulePage QCheckBox,
QWidget#modulePage QRadioButton {
    color: #FFFFFF;
    font-weight: bold;
    spacing: 8px;
}

/* 复选框：避免白底 + 浅灰勾；未选深底白边，选中深青绿底白边，勾由样式引擎以亮色绘制 */
QWidget#modulePage QCheckBox::indicator {
    width: 18px;
    height: 18px;
}

QWidget#modulePage QCheckBox::indicator:unchecked {
    background-color: rgba(30, 41, 59, 0.98);
    border: 2px solid rgba(255, 255, 255, 0.92);
    border-radius: 4px;
}

QWidget#modulePage QCheckBox::indicator:checked {
    background-color: #0D9488;
    border: 2px solid #FFFFFF;
    border-radius: 4px;
}

QWidget#modulePage QCheckBox::indicator:disabled {
    background-color: rgba(51, 65, 85, 0.6);
    border: 2px solid rgba(148, 163, 184, 0.5);
}

/* 单选：未选深底白边；选中实心深青 + 白边，圆点对比清晰 */
QWidget#modulePage QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QWidget#modulePage QRadioButton::indicator:unchecked {
    background-color: rgba(30, 41, 59, 0.98);
    border: 2px solid rgba(255, 255, 255, 0.92);
    border-radius: 9px;
}

QWidget#modulePage QRadioButton::indicator:checked {
    background-color: #0F766E;
    border: 3px solid #FFFFFF;
    border-radius: 9px;
}

QWidget#modulePage QRadioButton::indicator:disabled {
    background-color: rgba(51, 65, 85, 0.6);
    border: 2px solid rgba(148, 163, 184, 0.5);
}

QWidget#modulePage QGroupBox {
    color: #FFFFFF;
    font-weight: bold;
    background-color: rgba(15, 23, 42, 0.78);
    border: 2px solid rgba(255, 255, 255, 0.92);
    border-radius: 8px;
}

QWidget#modulePage QGroupBox::title {
    color: #FFFFFF;
    font-weight: bold;
    background-color: rgba(15, 23, 42, 0.92);
    padding: 2px 8px;
}

QWidget#modulePage QLineEdit,
QWidget#modulePage QComboBox,
QWidget#modulePage QSpinBox,
QWidget#modulePage QDoubleSpinBox {
    color: #FFFFFF;
    font-weight: bold;
    background-color: rgba(30, 41, 59, 0.92);
    border: 2px solid rgba(255, 255, 255, 0.65);
    selection-background-color: #0D9488;
    selection-color: #FFFFFF;
}

QWidget#modulePage QComboBox::drop-down {
    background-color: rgba(51, 65, 85, 0.9);
    border-left: 1px solid #64748B;
}

QWidget#modulePage QComboBox QAbstractItemView {
    background-color: rgba(15, 23, 42, 0.98);
    color: #FFFFFF;
    selection-background-color: #0F766E;
    selection-color: #FFFFFF;
    outline: none;
    padding: 2px;
}

QWidget#modulePage QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding: 4px 10px;
    color: #F8FAFC;
    background-color: rgba(15, 23, 42, 1);
}

QWidget#modulePage QComboBox QAbstractItemView::item:selected {
    background-color: #0F766E;
    color: #FFFFFF;
}

QWidget#modulePage QComboBox QAbstractItemView::item:hover {
    background-color: rgba(16, 118, 110, 0.55);
    color: #FFFFFF;
}

QWidget#modulePage QTextEdit,
QWidget#modulePage QPlainTextEdit {
    color: #FFFFFF;
    font-weight: bold;
    background-color: rgba(15, 23, 42, 0.82);
    border: 2px solid rgba(255, 255, 255, 0.65);
    selection-background-color: #0D9488;
    selection-color: #FFFFFF;
}

QWidget#modulePage QProgressBar {
    color: #FFFFFF;
    font-weight: bold;
    background-color: rgba(30, 41, 59, 0.85);
    border: 2px solid rgba(255, 255, 255, 0.65);
}

QWidget#modulePage QSlider::groove:horizontal {
    background: rgba(71, 85, 105, 0.85);
    border: 2px solid rgba(255, 255, 255, 0.55);
}

/* 四模块内按钮：统一灰蓝（slate）系，与半透明背景图协调 */
QWidget#modulePage QPushButton {
    background-color: #5A6B80;
    color: #FFFFFF;
    font-weight: bold;
    border: 2px solid rgba(255, 255, 255, 0.55);
}

QWidget#modulePage QPushButton:hover {
    background-color: #6D7F95;
    border: 2px solid rgba(255, 255, 255, 0.75);
    color: #FFFFFF;
}

QWidget#modulePage QPushButton:pressed {
    background-color: #3E4A5C;
    border: 2px solid rgba(255, 255, 255, 0.92);
    padding-top: 9px;
    padding-bottom: 7px;
}

QWidget#modulePage QPushButton:disabled {
    color: #94A3B8;
    background-color: rgba(90, 107, 128, 0.45);
    border-color: rgba(255, 255, 255, 0.35);
}

/* 主操作：同系略深的灰蓝，仍与整体一致 */
QWidget#modulePage QPushButton#primaryButton {
    background-color: #4A6078;
    color: #FFFFFF;
    border: 2px solid rgba(255, 255, 255, 0.85);
}

QWidget#modulePage QPushButton#primaryButton:hover {
    background-color: #5A7390;
    color: #FFFFFF;
    border: 2px solid rgba(255, 255, 255, 0.95);
}

QWidget#modulePage QPushButton#primaryButton:pressed {
    background-color: #3A4F63;
    border: 2px solid #FFFFFF;
    padding-top: 9px;
    padding-bottom: 7px;
}

QWidget#modulePage QPushButton#secondaryButton {
    background-color: #5A6B80;
    color: #FFFFFF;
    border: 2px solid rgba(255, 255, 255, 0.55);
}

QWidget#modulePage QPushButton#secondaryButton:hover {
    background-color: #6D7F95;
    border: 2px solid rgba(255, 255, 255, 0.75);
    color: #FFFFFF;
}

QWidget#modulePage QPushButton#secondaryButton:pressed {
    background-color: #3E4A5C;
    border: 2px solid rgba(255, 255, 255, 0.92);
}

QWidget#modulePage QToolButton {
    color: #FFFFFF;
    font-weight: bold;
    background-color: #5A6B80;
    border: 2px solid rgba(255, 255, 255, 0.45);
    border-radius: 4px;
}

QWidget#modulePage QToolButton:hover {
    background-color: #6D7F95;
    border: 2px solid rgba(255, 255, 255, 0.65);
    color: #FFFFFF;
}

QWidget#modulePage QToolButton:pressed {
    background-color: #3E4A5C;
    border: 2px solid rgba(255, 255, 255, 0.92);
}

QWidget#modulePage QToolButton:checked {
    background-color: #4E5D70;
    border: 2px solid rgba(255, 255, 255, 0.9);
}

QWidget#modulePage QToolButton:checked:hover {
    background-color: #5F6F84;
    border: 2px solid #FFFFFF;
}
